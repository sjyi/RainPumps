SMARTTHINGS_PAT=

# Admin UI auth (if api.auth_enabled in config.yaml)
API_KEY=
SMTP_PASSWORD=

# Google Sign-In for Gmail alerts (Admin → Email notifications)
# Create OAuth 2.0 Web client at https://console.cloud.google.com/
# Redirect URI: http://localhost:8080/api/auth/google/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Tuya Cloud — device import and remote control (set devices.control_mode: cloud in config.yaml)
TUYA_API_KEY=
TUYA_API_SECRET=
TUYA_API_REGION=us
TUYA_API_DEVICE_ID=

# Per-pump local keys (alternative to import / cloud)
TUYA_LOCAL_KEY_NORTH_PUMP=

# Meross Cloud — meross-test scripts and future pumpd integration
MEROSS_EMAIL=
MEROSS_PASSWORD=
MEROSS_API_BASE=https://iotx-us.meross.com
# MEROSS_MFA_CODE=
